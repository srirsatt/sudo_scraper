# Instagram account YOU log in with, not the creator's credentials.
INSTAGRAM_USERNAME=
# Optional. Leave blank to enter your password privately during --login.
INSTAGRAM_PASSWORD=

# Creator whose stories you can normally view. Confirm the exact handle.
INSTAGRAM_TARGET=zero2sudo

# Relative to the project directory, or use an absolute path.
# Contains your session cookies, collected media, and collection state.
COLLECTOR_DATA_DIR=data

# Local vision model: used by classifier.py, not collector.py.
# Native Ollama controls the context size per request; /v1 is stripped automatically.
# For other OpenAI-compatible servers, set LLM_API_STYLE=openai and include /v1.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_STYLE=ollama
LLM_MODEL=qwen3-vl:8b
LLM_CONTEXT_LENGTH=16384
# Local Ollama does not require a key. Set this only if your server requires one.
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=300

# Telegram is not implemented yet; no bot token is needed at this stage.
