# Instagram account YOU log in with, not the creator's credentials.
INSTAGRAM_USERNAME=
# Optional. Leave blank to enter your password privately during --login.
INSTAGRAM_PASSWORD=

# Creator whose stories you can normally view. Confirm the exact handle.
INSTAGRAM_TARGET=zero2sudo

# Relative to the project directory, or use an absolute path.
# Contains your session cookies, collected media, and collection state.
COLLECTOR_DATA_DIR=data

# Classifier provider: ollama, fireworks, openai, or custom.
# Only the selected provider is used; there is no automatic paid fallback.
LLM_PROVIDER=ollama

# Local Ollama. /v1 is stripped automatically for native requests.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen3-vl:8b-instruct
# Keep local reasoning disabled; the explicit Instruct model avoids thinking-tag bugs.
OLLAMA_THINK=false
LLM_CONTEXT_LENGTH=16384
# auto: linked job text first, fast vision fallback.
# thorough: three target frames plus nearby stories; fast: one smaller frame, no neighbors.
LLM_MODE=auto

# Shared limits. Local Qwen can take longer than 120 seconds on a laptop.
LLM_TIMEOUT_SECONDS=300
LLM_MAX_OUTPUT_TOKENS=1024

# Fireworks: set LLM_PROVIDER=fireworks, then fill in these two values.
# Copy the full vision model/deployment path available in your account.
# Example format: accounts/fireworks/models/MODEL_NAME
FIREWORKS_API_KEY=
FIREWORKS_MODEL=
# Optional override; the default inference URL is selected automatically.
# FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

# Optional OpenAI preset: set LLM_PROVIDER=openai and both values below.
# Choose a vision model supporting Chat Completions and structured outputs.
OPENAI_API_KEY=
OPENAI_MODEL=

# Custom OpenAI-compatible endpoint: set LLM_PROVIDER=custom, LLM_BASE_URL,
# LLM_MODEL, and this key if required by that endpoint.
LLM_API_KEY=

# Telegram: create a bot with @BotFather and keep its token private.
TELEGRAM_BOT_TOKEN=
# Numeric chat IDs, comma-separated; /start in a private chat adds the sender here.
# Share https://t.me/YOUR_BOT_USERNAME?start=internships and run review.py --watch.
# /stop removes the sender. Subscribers do not gain reviewer access.
# This setting is read live from .env and takes precedence over inherited values.
# For a group/channel, add the bot and give it permission to post.
# Discover recent IDs with: python notifier.py --list-chats
TELEGRAM_CHAT_IDS=
# Private chat receiving held stories with Approve / Skip buttons.
# Use your own positive private chat ID, never a group/channel ID.
TELEGRAM_REVIEW_CHAT_ID=
# Optional: reviewer Telegram user ID; defaults to the private review chat ID.
TELEGRAM_REVIEW_USER_ID=
# Run python review.py --watch alongside the pipeline to handle buttons.
# Sender defaults: stories no older than 24 hours, max 20 delivery attempts/run.
# Override per run with --max-age-hours and --limit.
